// Cloudflare Workers configuration. The finished website is dist/ (built by `npm run build`
// and committed), so Cloudflare publishes that folder as it is.
{
  "name": "inkstep",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // / serves index.html
    "html_handling": "auto-trailing-slash"
  }
}
